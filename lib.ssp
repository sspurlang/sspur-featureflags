  no = evaluate(s, "needs", ctx("u", [("country", "US")]))
  ghost = evaluate(s, "needs-missing", context("u"))
  cyc = evaluate(s, "cyc-a", context("u"))
  ok_.reason == Static and ok_.variant == some("on") and no.reason == PrerequisiteFailed and no.variant == some("off") and no.rule == some("prerequisite:color") and ghost.reason == PrerequisiteFailed and cyc.reason == ErrorReason and cyc.error == some(General) and cyc.message.contains("cycle")

test errors = do
