  f = Flag{key: "bad key!", enabled: true, variants: [("a", BoolV{v: true}), ("a", StrV{v: "x"})], off_variant: "z", fallthrough: Weighted{weights: [("a", -1), ("q", 0)], bucket_by: ""}, targets: [Target{variant: "q", keys: ["u"]}], rules: [rule("r", "n", Lt, ["x"], Fixed{variant: "a"}), rule("r", "n", Equals, [], Fixed{variant: "a"}), rule("t", "n", Matches, ["("], Fixed{variant: "a"}), rule("u", "n", Exists, ["x"], Fixed{variant: "a"}), rule("v", "n", Before, ["soon"], Fixed{variant: "a"}), rule("w", "", In, [], Fixed{variant: "a"}), Rule{id: "x", when: SegmentClause{segment: "none"}, serve: Fixed{variant: "a"}}], prerequisites: [], salt: "", version: 0}
  g = Segment{key: "g", included: [], excluded: [], rules: [SegmentClause{segment: "g"}]}
  ps = problems(snapshot([f, bool_flag("p", true).add_prereq("bad key!", ["nope"])], [g]))
  expect = ["the key must be", "names a variant twice", "one type", "off_variant: no variant 'z'", "weight of 'a' is negative", "no variant 'q'", "needs a positive weight", "bucket_by: is empty", "targets[0].variant", "two rules have one id", "'x' is not a number", "takes exactly one value, got 0", "bad regular expression", "takes no values", "not an ISO 8601 time", "attr: is empty", "needs at least one value", "no segment 'none'", "segments may not refer to segments", "has no variant 'nope'"]
  expect.all(e => ps.any(p => p.contains(e)))

fn doc() -> Str
= "\{\"flags\": [\{\"key\": \"checkout\", \"variants\": [\{\"name\": \"on\", \"boolean\": true}, \{\"name\": \"off\", \"boolean\": false}], \"off_variant\": \"off\", \"fallthrough\": \{\"split\": [\{\"variant\": \"on\", \"weight\": 20}, \{\"variant\": \"off\", \"weight\": 80}]}, \"targets\": [\{\"variant\": \"off\", \"keys\": [\"blocked\"]}], \"rules\": [\{\"id\": \"staff\", \"when\": \{\"any\": [\{\"segment\": \"staff\"}, \{\"attr\": \"plan\", \"op\": \"in\", \"values\": [\"enterprise\"]}]}, \"serve\": \{\"variant\": \"on\"}}, \{\"id\": \"never\", \"when\": \{\"negate\": \{\"always\": true}}, \"serve\": \{\"variant\": \"off\"}}]}, \{\"key\": \"theme\", \"enabled\": false, \"variants\": [\{\"name\": \"dark\", \"string\": \"dark\"}], \"off_variant\": \"dark\", \"fallthrough\": \{\"variant\": \"dark\"}, \"prerequisites\": [\{\"flag\": \"checkout\", \"variants\": [\"on\"]}]}], \"segments\": [\{\"key\": \"staff\", \"rules\": [\{\"attr\": \"email\", \"op\": \"ends_with\", \"values\": [\"@corp.example\"]}]}]}"

test decode_document = match decode(doc())
  | ok(s) => s.flags.len == 2 and s.segments.len == 1 and is_on(s, "checkout", ctx("x", [("email", "a@corp.example")]), false) and is_on(s, "checkout", ctx("x", [("plan", "enterprise")]), false) and not is_on(s, "checkout", ctx("blocked", [("plan", "enterprise")]), true) and evaluate(s, "theme", context("x")).reason == Disabled and s.flags.get("checkout").map(f => f.enabled) == some(true)
  | err(_) => false

test encode_round_trip = match decode(doc())
  | ok(s) => decode(encode(s)) == ok(s) and decode(encode(flags() with flags := flags().flags.remove("broken").remove("cyc-a").remove("cyc-b").remove("needs-missing"))) == ok(flags() with flags := flags().flags.remove("broken").remove("cyc-a").remove("cyc-b").remove("needs-missing"))
  | err(_) => false

fn decode_err(text: Str) -> Str
= match decode(text)
  | ok(_) => ""
  | err(e) => e

test decode_errors = decode_err(doc().replace("\"in\"", "\"inn\"")) == "flags[0].rules[0].when.any[1].op: unknown operator 'inn'" and decode_err(doc().replace("\{\"segment\": \"staff\"}", "\{\"segment\": \"staff\", \"always\": true}")) == "flags[0].rules[0].when.any[0]: a clause has exactly one of attr, segment, all, any, negate, always" and decode_err(doc().replace("\"boolean\": true}", "\"boolean\": true, \"string\": \"x\"}")) == "flags[0].variants[0]: a variant has exactly one of boolean, string, integer, number" and decode_err(doc().replace("\"serve\": \{\"variant\": \"on\"}", "\"serve\": \{}")) == "flags[0].rules[0].serve: a serve has exactly one of variant, split" and decode_err("\{\"flags\": [\{\"key\": 1}]}").starts_with("flags[0].key") and decode_err("not json") != "" and decode_err(doc().replace("\"key\": \"theme\"", "\"key\": \"checkout\"")) == "flags: the key 'checkout' is used twice" and decode_err(doc().replace("\"staff\"}", "\"staf\"}")).contains("no segment 'staf'")

test decode_more_errors = decode_err(doc().replace("\"plan\", \"op\": \"in\"", "\"plan\"")) == "flags[0].rules[0].when.any[1].op: is missing" and decode_err(doc().replace("\{\"segment\": \"staff\"}", "\{\"segment\": \"staff\", \"op\": \"in\"}")).contains("op and values belong to an attr clause") and decode_err(doc().replace("\"serve\": \{\"variant\": \"on\"}", "\"serve\": \{\"variant\": \"on\", \"bucket_by\": \"org\"}")) == "flags[0].rules[0].serve.bucket_by: belongs to a split"

test single_definitions = do
  f = decode_flag(encode_flag(colors()))
  g = decode_segment(encode_segment(beta()))
  f == ok(colors()) and g == ok(beta()) and decode_flag("\{}").is_err and decode_segment("[]").is_err and decode_flag(encode_flag(colors()).replace("\"In\"", "x")) == ok(colors())

test files = do
  path = env_var("TMPDIR").or("/tmp") + "/featureflags-test-{now_ms()}.json"
  w = write_file(path, doc())
  loaded = load_file(path)
  gone = remove_file(path)
  loaded.map(s => s.flags.keys) == ok(["checkout", "theme"]) and load_file(path).is_err

test fingerprints = do
  s = flags()
  fingerprint(s) == fingerprint(snapshot(s.flags.values.reverse, s.segments.values)) and fingerprint(s) != fingerprint(s with flags := s.flags.remove("plain"))

test builders = do
  f = bool_flag("b", true).add_rule(rule("r", "x", Equals, ["1"], Fixed{variant: "off"})).add_target("off", ["k"]).add_prereq("p", ["on"]).with_fallthrough(Fixed{variant: "off"})
  s = string_flag("s", false, [("a", "A")], "a", "a")
  f.rules.len == 1 and f.targets == [Target{variant: "off", keys: ["k"]}] and f.prerequisites == [Prereq{flag: "p", variants: ["on"]}] and f.fallthrough == Fixed{variant: "off"} and s.variants == [("a", StrV{v: "A"})] and not s.enabled and snapshot([f, f with enabled := false], []).flags.get("b").map(x => x.enabled) == some(false)

// ---------- store tests ----------

fn st(f: () -> Bool ! db, fail[DbErr], fail[StoreErr]) -> Bool ! db
= catch st_inner(f)
  | Sql | Constraint | Busy | NoRow | Mismatch => false

fn st_inner(f: () -> Bool ! db, fail[DbErr], fail[StoreErr]) -> Bool ! db, fail[DbErr]
= catch f()
  | Invalid | Conflict | NotFound => false

fn store_err(f: () -> Unit ! db, fail[DbErr], fail[StoreErr]) -> Opt[StoreErr] ! db, fail[DbErr]
= catch do
  f()
  none
| Invalid{msg} => some(Invalid{msg})
| Conflict{key, expected, actual} => some(Conflict{key, expected, actual})
| NotFound{key} => some(NotFound{key})

fn t0() -> Time
= time_ms(1767225600000)

fn fresh() -> Db ! db, fail[DbErr]
= do
  c = db.open(":memory:")
  open_store(c)
  open_store(c)
  c

test store_put_and_load = st(() => do
  c = fresh()
  v0 = store_version(c)
  g = put_segment(c, beta(), some(0), "ada", t0())
  f = put_flag(c, colors(), some(0), "ada", t0())
  f2 = put_flag(c, colors() with enabled := false, some(1), "bob", t0().add(secs(5)))
  s = load_store(c)
  v0 == 0 and g == 1 and f.version == 1 and f2.version == 2 and store_version(c) == 3 and s.version == 3 and s.flags.get("color") == some(colors() with enabled := false, version := 2) and s.segments.get("beta") == some(beta()) and evaluate(s, "color", context("u")).reason == Disabled)

test store_conflicts = st(() => do
  c = fresh()
  f = put_flag(c, bool_flag("a", true), none, "ada", t0())
  stale = store_err(() => do
    x = put_flag(c, bool_flag("a", false), some(0), "bob", t0())
    ())
  fresh_ok = put_flag(c, bool_flag("a", false), some(1), "bob", t0())
  stale == some(Conflict{key: "a", expected: 0, actual: 1}) and fresh_ok.version == 2)

test store_validates = st(() => do
  c = fresh()
  bad = store_err(() => do
    x = put_flag(c, colors(), none, "ada", t0())
    ())
  seg = put_segment(c, beta(), none, "ada", t0())
  f = put_flag(c, colors(), none, "ada", t0())
  dep = put_flag(c, bool_flag("needs", true).add_prereq("color", ["blue"]), none, "ada", t0())
  del_used = store_err(() => delete_flag(c, "color", none, "ada", t0()))
  seg_used = store_err(() => delete_segment(c, "beta", none, "ada", t0()))
  gone = store_err(() => delete_flag(c, "nope", none, "ada", t0()))
  gone_seg = store_err(() => delete_segment(c, "nope", none, "ada", t0()))
  bad.map(e => e is Invalid{msg} and msg.contains("no segment 'beta'")) == some(true) and del_used.map(e => e is Invalid{msg} and msg.contains("no flag 'color'")) == some(true) and seg_used.map(e => e is Invalid{msg: _}) == some(true) and gone == some(NotFound{key: "nope"}) and gone_seg == some(NotFound{key: "nope"}) and store_version(c) == 3)

test store_deletes_and_history = st(() => do
  c = fresh()
  f = put_flag(c, bool_flag("a", true), none, "ada", t0())
  g = put_flag(c, bool_flag("a", false), none, "bob", t0().add(secs(1)))
  delete_flag(c, "a", some(2), "cy", t0().add(secs(2)))
  s = put_segment(c, beta(), none, "ada", t0())
  delete_segment(c, "beta", some(1), "ada", t0())
  h = history(c, "flag", "a")
  hs = history(c, "segment", "beta")
  h.map(e => (e.action, e.actor, e.version)) == [("put", "ada", 1), ("put", "bob", 2), ("delete", "cy", 3)] and h[0].definition.map(d => decode_flag(d).is_ok) == some(true) and h[2].definition == none and h[1].at == t0().add(secs(1)) and hs.map(_.action) == ["put", "delete"] and load_store(c).flags.len == 0 and changes_since(c, 3).map(_.key) == ["beta", "beta"])

test store_polling = st(() => do
  c = fresh()
  f = put_flag(c, bool_flag("a", true), none, "ada", t0())
  s = load_store(c)
  same = reload_if_changed(c, s.version)
  g = put_flag(c, bool_flag("a", false), none, "ada", t0())
  next = reload_if_changed(c, s.version)
  same == none and next.map(n => (n.version, is_on(n, "a", context("u"), true))) == some((2, false)))

test store_import = st(() => do
  c = fresh()
  old = put_flag(c, bool_flag("legacy", true), none, "ada", t0())
  v = import_snapshot(c, flags() with flags := flags().flags.remove("broken").remove("cyc-a").remove("cyc-b").remove("needs-missing"), "deploy", t0())
  again = import_snapshot(c, load_store(c), "deploy", t0())
  s = load_store(c)
  bad = store_err(() => do
    x = import_snapshot(c, flags(), "deploy", t0())
    ())
  s.flags.has("color") and not s.flags.has("legacy") and s.segments.has("beta") and again == v and bad.map(e => e is Invalid{msg: _}) == some(true) and changes_since(c, 0).any(e => e.key == "legacy" and e.action == "delete"))

test store_evaluates_directly = st(() => do
  c = fresh()
  g = put_segment(c, beta(), none, "ada", t0())
  f = put_flag(c, colors(), none, "ada", t0())
  n = put_flag(c, bool_flag("needs", true).add_prereq("color", ["blue"]), none, "ada", t0())
  s = load_store(c)
  ctxs = [context("vip"), ctx("u", [("country", "DE")]), context("tester"), context("plain")]
  ctxs.all(x => evaluate_stored(c, "needs", x) == evaluate(s, "needs", x) and evaluate_stored(c, "color", x) == evaluate(s, "color", x)) and evaluate_stored(c, "nope", context("u")).error == some(FlagNotFound))
