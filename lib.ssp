  eu = evaluate(s, "color", ctx("u", [("country", "FR")]))
  t = evaluate(s, "color", ctx("tester", [("country", "FR")]))
  b = evaluate(s, "color", context("vip"))
  eu.reason == TargetingMatch and eu.rule == some("eu") and eu.value == some(StrV{v: "#00f"}) and t.variant == some("green") and t.rule == some("target:green") and b.reason == Split and b.rule == some("beta") and ["blue", "green"].contains(b.variant.or(""))

test prerequisites = do
